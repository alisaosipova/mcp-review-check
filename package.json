{
  "name": "mcp-review-check",
  "version": "0.6.0",
  "description": "Lint an MCP server against the Claude connector directory, ChatGPT plugin directory and MCP spec review criteria.",
  "homepage": "https://github.com/alisaosipova/mcp-review-check#readme",
  "bugs": {
    "url": "https://github.com/alisaosipova/mcp-review-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisaosipova/mcp-review-check.git"
  },
  "type": "module",
  "bin": {
    "mcp-review-check": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "readme:rules": "node scripts/rules-table.mjs --write",
    "prepack": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "lint",
    "linter",
    "static-analysis",
    "security",
    "claude",
    "chatgpt",
    "anthropic",
    "openai",
    "connector",
    "apps-sdk",
    "sarif",
    "junit",
    "github-actions",
    "ci",
    "cli",
    "llm",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "ajv": "^8.20.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}
