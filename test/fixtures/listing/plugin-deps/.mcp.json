{
  "mcpServers": {
    "acme": {
      "type": "http",
      "url": "https://mcp.acme.test/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_token}"
      }
    },
    "acme-local": {
      "command": "npx",
      "args": [
        "-y",
        "@acme/notes-mcp@1.4.2"
      ],
      "env": {
        "ACME_TOKEN": "${user_config.api_token}"
      }
    }
  }
}
